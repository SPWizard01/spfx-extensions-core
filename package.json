{
  "name": "@spfx-extensions/core",
  "description": "Core Library used by SPFxExtensions",
  "author": "SPWizard01",
  "license": "GPL-3.0-only",
  "type": "module",
  "version": "0.0.9",
  "access": "public",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPWizard01/spfx-extensions-core"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./spfxCoreEntry": "./dist/core/__spfxCore.js",
    "./configurator": "./dist/configurator/__spfxCoreConfigurator.js",
    "./context": "./dist/services/spContextService.js",
    "./launcher": "./dist/services/appLauncher.js",
    "./utils/display": "./dist/utilities/display.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prewebpack": "tsc ./src/plugins/webpack/manifestPlugin.ts --target esnext --module esnext --moduleResolution bundler --skipLibCheck true",
    "webpack": "webpack --config webpackbuild.js",
    "esbuild": "bun run esbuild.ts",
    "esserve": "bun run esserve.ts",
    "build": "bun run bunbuild.ts",
    "serve": "bun run serve.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "bun-dev-server": "^0.0.6",
    "esbuild": "^0.24.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.56.1",
    "@pnp/sp": "^4.6.0",
    "bun": "^1.1.34",
    "idb": "^8.0.0",
    "react": "19.0.0-rc.1",
    "react-dom": "19.0.0-rc.1"
  }
}
